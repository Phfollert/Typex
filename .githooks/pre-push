#!/usr/bin/env sh
# Pre-push hook: lint + typecheck the frontend, but only when the pushed
# commits touch files under frontend/. Backend-only pushes skip clean.
#
# This repo holds both frontend/ (TS) and backend/ (Python) under one root.
# Activate once per clone with:
#   git config core.hooksPath .githooks
set -e

# git feeds one line per ref being pushed on stdin:
#   <local ref> <local oid> <remote ref> <remote oid>
# An all-zero oid is git's "ref does not exist" sentinel (length varies by hash algo).
is_null() { case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac; }

changed=""
while read local_ref local_oid remote_ref remote_oid; do
  is_null "$local_oid" && continue                    # branch deletion: nothing to check

  if is_null "$remote_oid"; then
    revs=$(git rev-list "$local_oid" --not --remotes) # new remote branch: commits not pushed anywhere yet
  else
    revs=$(git rev-list "$remote_oid..$local_oid")
  fi

  [ -z "$revs" ] && continue
  changed="$changed
$(printf '%s\n' "$revs" | git diff-tree --stdin --no-commit-id --name-only -r)"
done

if printf '%s\n' "$changed" | grep -q '^frontend/'; then
  echo "Frontend changes detected — running lint + typecheck..."
  cd "$(git rev-parse --show-toplevel)/frontend"
  npm run lint
  npm run typecheck
  echo "Frontend checks passed."
else
  echo "No frontend changes in this push — skipping frontend checks."
fi
